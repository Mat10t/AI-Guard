    {
      "name": "07 Internal ingest",
      "item": [
        {
          "name": "Internal audit ingest",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"project_id\": \"{{project_id}}\",\n  \"api_key_id\": \"{{key_id}}\",\n  \"actor_user_id\": \"{{admin_user_id}}\",\n  \"action\": \"postman.audit.event\",\n  \"object_type\": \"postman\",\n  \"object_id\": \"{{project_id}}\",\n  \"details\": {\"source\": \"postman\"}\n}"
