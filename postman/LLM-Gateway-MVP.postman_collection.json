            "url": "{{analytics_url}}/internal/audit/event"
          }
        },
        {
          "name": "Internal usage ingest",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"project_id\": \"{{project_id}}\",\n  \"api_key_id\": \"{{key_id}}\",\n  \"requested_model\": \"gpt-5.4-mini\",\n  \"effective_model\": \"mock-fast\",\n  \"model\": \"mock-fast\",\n  \"input_tokens\": 10,\n  \"output_tokens\": 20,\n  \"total_tokens\": 30,\n  \"estimated_cost\": 0\n}"
            },
            "url": "{{analytics_url}}/internal/usage/record"
