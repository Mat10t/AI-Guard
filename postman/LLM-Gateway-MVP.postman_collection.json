          }
        },
        {
          "name": "Export usage CSV",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "const raw = pm.response.text();", "pm.expect(raw).to.include('day,project_id,model');"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{analytics_url}}/reports/csv/usage?scope=project&project_id={{project_id}}"
          }
        },
        {
          "name": "Export audit CSV",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "const raw = pm.response.text();", "pm.expect(raw).to.include('created_at,actor_user_id,action');"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{analytics_url}}/reports/csv/audit?scope=project&project_id={{project_id}}"
          }
        },
        {
          "name": "Export logs CSV",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "const raw = pm.response.text();", "pm.expect(raw).to.include('created_at,request_id,project_id');"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
