#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ ! "$branch" =~ ^(feat|fix)/([0-9]{2}-[0-9]{2})-[a-z0-9-]+$ ]]; then
  exit 0
fi

task_id="${BASH_REMATCH[2]}"
first_line="$(head -n1 "$msg_file" | tr -d '\r')"

if [[ ! "$first_line" =~ ^${task_id}:\  ]]; then
  echo "ERROR: commit message must start with '${task_id}: '" >&2
  echo "Current first line: ${first_line}" >&2
  exit 1
fi
